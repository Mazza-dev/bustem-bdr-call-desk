PORT=8787
HOST=127.0.0.1
# Set APP_TOKEN before binding to a network interface.
APP_TOKEN=
# Make custom webhook. Leave empty to preview events without sending them.
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_KEY=
# Demo events stay local unless this is deliberately enabled for a test scenario.
ALLOW_DEMO_WEBHOOK=false
BDR_NAME=BDR to confirm
# Parley runs a local MCP endpoint while its app is open. Check its Settings for the actual port.
PARLEY_MCP_URL=http://127.0.0.1:3011/mcp
PARLEY_TITLE_PREFIX=Bustem
# Optional: use a Parley folder ID instead of a title prefix.
PARLEY_FOLDER_ID=
PARLEY_POLL_SECONDS=20
CALL_DESK_URL=http://127.0.0.1:8787
